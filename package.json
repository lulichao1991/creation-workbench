{
  "name": "workbench",
  "private": true,
  "version": "0.2.0-beta.3",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix agent-host install --ignore-scripts",
    "dev": "vite",
    "build": "npm run build:agent-host && tsc && vite build",
    "build:agent-host": "npm --prefix agent-host run build && node scripts/prepare-agent-host-runtime.mjs",
    "test": "vitest run",
    "test:agent-host": "npm --prefix agent-host run check",
    "test:all": "npm test && npm run test:agent-host",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
